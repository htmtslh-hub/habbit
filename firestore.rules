rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USERS COLLECTION =====
    match /users/{userId} {

      // Anyone authenticated can READ their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can WRITE their own document BUT cannot modify protected fields
      // Protected fields: role, plan, disabled, planExpiresAt, trialExpiresAt,
      //                   upgradeApprovedAt, upgradeRejectedAt
      allow write: if request.auth != null && request.auth.uid == userId
        && (!resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role)
        && (!resource.data.keys().hasAny(['plan']) || request.resource.data.plan == resource.data.plan)
        && (!resource.data.keys().hasAny(['disabled']) || request.resource.data.disabled == resource.data.disabled)
        && (!resource.data.keys().hasAny(['planExpiresAt']) || request.resource.data.planExpiresAt == resource.data.planExpiresAt)
        && (!resource.data.keys().hasAny(['trialExpiresAt']) || request.resource.data.trialExpiresAt == resource.data.trialExpiresAt)
        && (!resource.data.keys().hasAny(['upgradeApprovedAt']) || request.resource.data.upgradeApprovedAt == resource.data.upgradeApprovedAt)
        && (!resource.data.keys().hasAny(['upgradeRejectedAt']) || request.resource.data.upgradeRejectedAt == resource.data.upgradeRejectedAt);

      // Users can CREATE their own document (first-time registration)
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role != 'admin';

      // Admin can read/write ALL user data (no field restrictions)
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== SUBCOLLECTIONS UNDER USERS =====
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== PAYMENTS COLLECTION =====
    match /payments/{paymentId} {
      // Users can CREATE a payment for themselves
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount > 0;

      // Users can READ their own payments
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      // Users CANNOT update/delete payments (only Cloud Functions via Admin SDK)
      // Admin can read all payments
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}