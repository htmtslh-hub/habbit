rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USERS COLLECTION =====
    match /users/{userId} {

      // Anyone authenticated can READ their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can WRITE their own document BUT cannot modify protected fields
      // Protected fields: role, plan, disabled, planExpiresAt, trialExpiresAt,
      //                   upgradeApprovedAt, upgradeRejectedAt
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role != 'admin'
        && (!resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role)
        && (!resource.data.keys().hasAny(['plan']) || request.resource.data.plan == resource.data.plan)
        && (!resource.data.keys().hasAny(['disabled']) || request.resource.data.disabled == resource.data.disabled)
        && (!resource.data.keys().hasAny(['planExpiresAt']) || request.resource.data.planExpiresAt == resource.data.planExpiresAt)
        && (!resource.data.keys().hasAny(['trialExpiresAt']) || request.resource.data.trialExpiresAt == resource.data.trialExpiresAt)
        && (!resource.data.keys().hasAny(['upgradeApprovedAt']) || request.resource.data.upgradeApprovedAt == resource.data.upgradeApprovedAt)
        && (!resource.data.keys().hasAny(['upgradeRejectedAt']) || request.resource.data.upgradeRejectedAt == resource.data.upgradeRejectedAt);

      // Users can CREATE their own document (first-time registration)
      // Disallow self-assigning admin, active paid plans, or fake expiry dates
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role != 'admin'
        && (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan in ['trial', 'free'])
        && (!request.resource.data.keys().hasAny(['disabled']) || request.resource.data.disabled == false)
        && (!request.resource.data.keys().hasAny(['planExpiresAt']) || request.resource.data.planExpiresAt == null)
        && (!request.resource.data.keys().hasAny(['upgradeApprovedAt']) || request.resource.data.upgradeApprovedAt == null);

      // Admin can read/write ALL user data (no field restrictions)
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== SUBCOLLECTIONS UNDER USERS =====
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== PAYMENTS COLLECTION =====
    match /payments/{paymentId} {
      // Users can CREATE a payment for themselves
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount > 0;

      // Users can READ their own payments
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      // Users CANNOT update/delete payments (only Cloud Functions via Admin SDK)
      // Admin can read all payments
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== OTP CODES COLLECTION =====
    // Server-only via Admin SDK. No client access.
    match /otp_codes/{otpId} {
      allow read, write: if false;
    }

    // ===== OTP ATTEMPTS COLLECTION =====
    // Server-only via Admin SDK. No client access.
    match /otp_attempts/{attemptId} {
      allow read, write: if false;
    }

    // ===== COMMUNITY POSTS COLLECTION =====
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Author and Admin can update everything.
      // Other users can only interact (likes/comments) without altering author or content.
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.content == resource.data.content
        )
      );
      allow delete: if request.auth != null && (
        resource.data.uid == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ===== LEADERBOARD COLLECTION =====
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      // Admin can write to any leaderboard entry (for DP grants)
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== SURPRISE QUESTS COLLECTION =====
    match /surprise_quests/{questId} {
      allow read: if request.auth != null;
      // Only admin can create/update/delete quests
      allow create, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Submissions subcollection
      match /submissions/{subId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == subId;
        allow update: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
    }

    // ===== SYSTEM CONFIG =====
    match /system_config/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== DP GRANTS LOG =====
    match /dp_grants/{grantId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== EMAIL LOGS (RESEND) =====
    match /email_logs/{logId} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== SQUADS COLLECTION (Trụ Cột 3: Tổ Đội Rèn Luyện) =====
    // KHÔNG có rule nào cho collection này trước đây -> Firestore mac dinh
    // deny-by-default nen toan bo tinh nang tao/gia nhap/dong bo Squad da
    // bi tu choi am tham (boc trong try/catch) doi voi nguoi dung that.
    match /squads/{squadId} {
      allow read: if request.auth != null;

      // Chi cho tao khi nguoi tao (createdBy) la chinh minh
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;

      // Bat ky thanh vien nao (tao/tham gia/roi doi/nudge/check-in dong bo/len bac)
      // deu can ghi vao cung 1 document. Khong the kiem tra "co phai la thanh
      // vien" bang Rules thuan tuy vi `members` la array-of-map (khong ho tro
      // loc theo truong con). De bao ve, chi khoa cac truong dinh danh cot loi:
      // chu so huu (createdBy), ma moi (code) va ten doi khong the bi doi boi
      // nguoi ngoai doi truong.
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        (
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.code == resource.data.code &&
          request.resource.data.name == resource.data.name
        )
      );

      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // Tin nhan trong kenh chat cua To Doi
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      }
    }

    // ===== DUELS COLLECTION (Trụ Cột 3: Đấu Trường Thách Đấu 1v1) =====
    // Cung khong co rule truoc day -> bi deny-by-default tuong tu squads.
    match /duels/{duelId} {
      allow read: if request.auth != null;

      // Chi nguoi thach dau (challenger) moi duoc tao phong
      allow create: if request.auth != null && request.resource.data.challenger.uid == request.auth.uid;

      // Challenger hoac Opponent duoc cap nhat tien do hang ngay. Nguoi thu 3
      // nhan keo mo (accept) duoc phep ghi opponent, nhung khong duoc doi
      // challenger hay so DP dat cuoc (betDP) cua tran dau.
      allow update: if request.auth != null && (
        resource.data.challenger.uid == request.auth.uid ||
        (resource.data.opponent != null && resource.data.opponent.uid == request.auth.uid) ||
        (
          request.resource.data.challenger == resource.data.challenger &&
          request.resource.data.betDP == resource.data.betDP
        )
      );

      // Chi challenger hoac opponent duoc huy/xoa phong dau
      allow delete: if request.auth != null && (
        resource.data.challenger.uid == request.auth.uid ||
        (resource.data.opponent != null && resource.data.opponent.uid == request.auth.uid)
      );
    }

    // ===== DIRECT CONVERSATIONS (INBOX) =====
    match /conversations/{convId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create, update: if request.auth != null && (
        request.auth.uid in request.resource.data.participants ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      // Direct Messages Subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
        allow create: if request.auth != null && (
          (request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
        allow update: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
        allow delete: if request.auth != null && (
          resource.data.senderId == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
      }
    }
  }
}