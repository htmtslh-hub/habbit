{
  "name": "habit-mastery",
  "version": "1.0.0",
  "description": "Habit Mastery - Theo dõi thói quen hàng ngày, xây dựng kỷ luật, đạt mục tiêu",
  "main": "main.js",
  "author": "SonnHai",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win nsis portable",
    "build:mac": "electron-builder --mac",
    "build:mac:arm64": "electron-builder --mac --arm64",
    "build:mac:x64": "electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sonnhai.habitmastery",
    "productName": "Habit Mastery",
    "copyright": "Copyright © 2026 SonnHai",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "web",
        "filter": [
          "index.html",
          "app.js",
          "i18n.js",
          "gotiengviet.js",
          "nameplate_templates.js",
          "avatar_frames.js",
          "book_covers.js",
          "doc_nhan_tinh_data.js",
          "all_books_data.js",
          "style.css",
          "auth.html",
          "auth.js",
          "auth.css",
          "admin.html",
          "admin.js",
          "admin.css",
          "favicon.svg",
          "icon-192.png",
          "icon-512.png",
          "zalo-qr.png",
          "coin-avatar-vector.svg",
          "pomodoro_chalkboard_guide.jpg",
          "pomodoro_huong_dan_tieng_viet.jpg",
          "assets/**",
          "manifest.json",
          "404.html",
          "sw.js"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon-clean.png",
      "artifactName": "HabitMastery-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Habit Mastery",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "HabitMastery-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "icon-mac-1024.png",
      "category": "public.app-category.lifestyle",
      "artifactName": "HabitMastery-mac-${arch}-${version}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "Habit Mastery Cài Đặt"
    }
  }
}
