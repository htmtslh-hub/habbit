{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "functions": {
    "api/cron-daily-reminders.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-daily-reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
