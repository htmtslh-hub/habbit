{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "habitmastery",
      "public": "./",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/.*/**",
        "**/node_modules/**",
        "electron/**",
        "dist/**",
        "functions/**",
        "api/**",
        "skills/**",
        "traffice/**",
        "create_test_user.js",
        "create_mock_accounts.js",
        "verify_mock_users.js",
        "update_mock_avatars.js",
        "ideas.txt",
        "content-type.txt",
        "facebook/**",
        "serviceAccountKey.json",
        "*.bat",
        "*.sh",
        "**/*.exe",
        "downloads/*.zip",
        "*.tar.gz",
        "vercel.json",
        "package.json",
        "package-lock.json",
        "firestore.rules",
        "firestore.indexes.json",
        "*.md"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        },
        {
          "source": "downloads/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, immutable"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|ico|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=86400"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/pricing",
          "destination": "/pricing.html"
        },
        {
          "source": "/terms",
          "destination": "/terms.html"
        },
        {
          "source": "/privacy",
          "destination": "/privacy.html"
        },
        {
          "source": "/refund",
          "destination": "/refund.html"
        },
        {
          "source": "/blog",
          "destination": "/blog.html"
        }
      ],
      "redirects": [
        {
          "regex": "^/(?P<rest>.*)$",
          "destination": "https://habit-mastery.com/:rest",
          "type": 301
        }
      ]
    },
    {
      "site": "sonnhai-2600f",
