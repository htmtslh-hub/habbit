{
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "habit-tracker-sonnhai",
    "public": "./",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "electron/**",
      "dist/**",
      "functions/**",
      "api/**",
      "vercel.json",
      "package.json",
      "package-lock.json",
      "firestore.rules",
      "firestore.indexes.json",
      "*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=3600" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|ico|svg)",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=86400" }
        ]
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Habit Tracker",
        "supportEmail": "htmt.slh@gmail.com"
      }
    }
  }
}
